# ==============================================================================
# Legal Metrology Vision Backend - Environment Configuration
# ==============================================================================

# Google Gemini API Key (or comma-separated list of keys for auto-rotation)
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEYS=key1,key2,key3

# Server Network Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated, default is "*" in development)
ALLOWED_ORIGINS=http://localhost:3000,https://legal-metrology-web.vercel.app
